amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["cargo-fmt"] = Builtins.cargo_fmt
    ["cargo-clippy"] = (Builtins.cargo_clippy) {
        check = new CommandSpec {
            command = "cargo clippy -- -D warnings"
            effect = "write"
        }
        fix = new CommandSpec {
            command = "cargo clippy --fix --allow-dirty -- -D warnings"
            effect = "write"
        }
    }
    // lints GitHub Actions workflows (jdx/jactionlint, a maintained actionlint fork)
    ["jactionlint"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
        batch = true
        check = new CommandSpec {
            command = "jactionlint {{ files }}"
            effect = "read"
        }
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
